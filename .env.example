# Copy to .env (gitignored). Generate the key at https://build.nvidia.com -> Manage API Keys.
# Never commit the real value.
NVIDIA_API_KEY=nvapi-...

# Optional: run a role on a self-hosted NIM instead of NVIDIA Build. Same API,
# different URL. Leave unset to use Build. Roles: ASSISTANT, JUDGE, EMBED.
# EVIDENCE_ASSISTANT_BASE_URL=http://rtx-3se-05-36:8000/v1
# EVIDENCE_ASSISTANT_MODEL=nvidia/nemotron-3.5-lightning
